// Linear TAG-211 Example 12.18 Bundling digits into numbers
4BITADD($A $B $CARRYIN)(SUM<> CARRYOUT<>)
4BITADD[([A<> 0..3] [B<> 0..3] CI<>)([$SUM0 $SUM1 $SUM2 $SUM3] $CO)

  FULLADD4BIT($A.0 $B.0 $CI)(SUM0<> C1<>)
  FULLADD4BIT($A.1 $B.1 $C1)(SUM1<> C2<>)
  FULLADD4BIT($A.2 $B.2 $C2)(SUM2<> C3<>)
  FULLADD4BIT($A.3 $B.3 $C3)(SUM3<> CO<>)
  :
]

FULLADD4BIT[(A<> B<> CI<>)($SUM $CO)
  @runtime(consumable)
  $A $B $CI :
K[SUM<K>] L[SUM<L>] M[CO<M>] N[CO<N>]
S,U,W[K,M] S,U,X[L,M] S,V,W[L,M] S,V,X[K,N]
T,U,W[L,M] T,U,X[K,N] T,V,W[K,N] T,V,X[L,N] 
]