// TAG-211: Example 12.18 Bundling digits into numbers
// 4-bit adder composed of four FULLADD instances, one per bit slice.
// Inputs: A0..A3, B0..B3 (the two 4-bit operands, LSB first),
//         CI (carry-in).
// Outputs: SUM0..SUM3 (the 4-bit sum, LSB first), CO (carry-out).
@dut(4BITADD_TEST)
@vectors(A0,A1,A2,A3,B0,B1,B2,B3,CI : SUM0,SUM1,SUM2,SUM3,CO)
@mode(wavefront)

// Token vocabulary (from FULLADD4BIT's rule table):
//   S = A=0   T = A=1
//   U = B=0   V = B=1
//   W = CI=0  X = CI=1
//   K = SUM=0 L = SUM=1
//   M = CO=0  N = CO=1
//
// Input wires carry S/T/U/V/W/X; output wires carry K/L/M/N.
// Using K/L for inputs collides with the callee's output symbols and
// triggers ConflictingBoundaryAssignment (the callee sees the input K
// and fires K[SUM<K>], conflicting with any L it also sees).
// 0 + 0 + 0 = 0, carry 0
S,S,S,S, U,U,U,U, W : K,K,K,K,M

// 0 + 0 + 1 = 1, carry 0
S,S,S,S, U,U,U,U, X : L,K,K,K,M

// 1 + 0 + 0 = 1, carry 0
T,S,S,S, U,U,U,U, W : L,K,K,K,M

// 1 + 1 + 0 = 2, carry 0
T,S,S,S, V,U,U,U, W : K,L,K,K,M

// 1 + 1 + 1 = 3, carry 0
T,S,S,S, V,U,U,U, X : L,L,K,K,M

// 15 + 1 + 0 = 16, carry 1
T,T,T,T, V,U,U,U, W : K,K,K,K,N 

// 15 + 15 + 0 = 30, carry 1
T,T,T,T, V,V,V,V, W : K,L,L,L,N