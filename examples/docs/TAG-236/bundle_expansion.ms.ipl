// TAG-236: bundle ranges, member access, and handle expansion
//
// A 4-bit ripple-carry adder, expressed with the new bundle syntax.
// Inputs A and B are 4-member bundles; the entry invocation passes
// them as bare handles ($A, $B); the elaborator expands each handle
// to the DUT's 4 members. Internal wiring reads individual wires
// with $A.0, $A.1, etc.
//
// The full adder is a lookup table over its three inputs (A, B, CIN)
// with two outputs (SUM, CARRY), matching the shape of TAG-130's
// FULLADD130.

FULLADD[(A<> B<> CI<>)(SUM<> CARRY<>)
  A,B,CI :
    0,0,0[SUM<0> CARRY<0>]
    0,0,1[SUM<1> CARRY<0>]
    0,1,0[SUM<1> CARRY<0>]
    0,1,1[SUM<0> CARRY<1>]
    1,0,0[SUM<1> CARRY<0>]
    1,0,1[SUM<0> CARRY<1>]
    1,1,0[SUM<0> CARRY<1>]
    1,1,1[SUM<1> CARRY<1>]
]

ADDER4($A $B $CIN)(SUM0<> SUM1<> SUM2<> SUM3<> COUT<>)
ADDER4[([A<> 0..3] [B<> 0..3] CIN<>)
  (SUM0<> SUM1<> SUM2<> SUM3<> COUT<>)
  // Four full-adder instances, chained by carry.
  FULLADD($A.0 $B.0 $CIN)(SUM0<> C1<>)
  FULLADD($A.1 $B.1 $C1)(SUM1<> C2<>)
  FULLADD($A.2 $B.2 $C2)(SUM2<> C3<>)
  FULLADD($A.3 $B.3 $C3)(SUM3<> COUT<>)
  :
]