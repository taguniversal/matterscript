// linear: TAG-151 Example 12.17 Bundling mutually exclusive path into a single path
OR($A $B)(Y< >)
OR[( [{A0< > A1< >}] [{B0< > B1< >}] ) ( [{$0 $1}] )

     1< 3of6($A1 $A1 $A0 $B0 $B1 $B1) >  // output = 1
     0< 2of2($A0 $B0) >                  // output = 0
     : 
]

// Stubs just to maker parser happy, this construct would be failry large wtih 64 rules
2of2[(A<> B<>)(Y<>)
  $A$B : K[Y<0>]
]

3of6[(I0<> I1<> I2<> I3<> I4<> I5<>)(Y<>)
  $I0$I1$I2$I3$I4$I5() : K[Y<0>]
]