// linear: TAG-146 Serial bus
fanin($selin {$in1 $in2})(serialmid<>)

fanout($selout $serialmid)({out1<> out2<> out3<> out4<>})

// TODO Link to TAG-180 Example 12.10
fanin[(select< > {in1< > in2< > in3< > in4< >})($out)

    $select( ) : A[out< $in1 >]
                 B[out< $in2 >]
                 C[out< $in3 >]
                 D[out< $in4>] 
]

// Definition matching invocation shape: fanout($selout $serialmid)({out1<> out2<> out3<> out4<>})
fanout[($selout $serialmid)({out1 out2 out3 out4})

    $selout() : A[out1< $serialmid >]
                B[out2< $serialmid >]
                C[out3< $serialmid >]
                D[out4< $serialmid >]

]


