@dut(bus)
@vectors(selector_in, selector_out, Q1, Q2, Q3, Q4 : out1, out2, out3, out4)

// --- Route Input Q1 (selector_in = A) to each Output ---
A, A, 1,0,0,0 : 1, 0, 0, 0
A, B, 1,0,0,0 : 0, 1, 0, 0
A, C, 1,0,0,0 : 0, 0, 1, 0
A, D, 1,0,0,0 : 0, 0, 0, 1

// --- Route Input Q2 (selector_in = B) to each Output ---
B, A, 0,1,0,0 : 1, 0, 0, 0
B, B, 0,1,0,0 : 0, 1, 0, 0
B, C, 0,1,0,0 : 0, 0, 1, 0
B, D, 0,1,0,0 : 0, 0, 0, 1

// --- Route Input Q3 (selector_in = C) to each Output ---
C, A, 0,0,1,0 : 1, 0, 0, 0
C, B, 0,0,1,0 : 0, 1, 0, 0
C, C, 0,0,1,0 : 0, 0, 1, 0
C, D, 0,0,1,0 : 0, 0, 0, 1

// --- Route Input Q4 (selector_in = D) to each Output ---
D, A, 0,0,0,1 : 1, 0, 0, 0
D, B, 0,0,0,1 : 0, 1, 0, 0
D, C, 0,0,0,1 : 0, 0, 1, 0
D, D, 0,0,0,1 : 0, 0, 0, 1

// --- Zero/Inactive Data Propagation Check ---
// When the active input channel carries a '0', all outputs should remain '0'
A, A, 0,0,0,0 : 0, 0, 0, 0
B, B, 0,0,0,0 : 0, 0, 0, 0
C, C, 0,0,0,0 : 0, 0, 0, 0
D, D, 0,0,0,0 : 0, 0, 0, 0
