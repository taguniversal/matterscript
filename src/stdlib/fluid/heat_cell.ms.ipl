// stdlib/fluid/heat_cell.ms.il
// Models thermal conduction at a single fin surface cell.
// Destinations: four neighbor temperatures $n $s $e $w
// Source: next temperature of this cell temp_out<>
//
// The table encodes a discrete Laplacian approximation:
// the cell temperature moves toward the average of its neighbors.
// This is the standard explicit finite difference heat equation.
// Boundary cells (coolant contact) have their temperature driven
// externally via cell[] actuator references.

HeatCell[($n $s $e $w)(temp_out<>)
  temp_out<$n$s$e$w()>
|
  // 4-neighbor average, quantized to 3-bit temperature (0-7)
  // key: n,s,e,w each 2 bits (0-3 range for table size)
  // for full 3-bit range this table would be generated by the compiler
  $n$s$e$w() :
    0000:0 0001:0 0010:0 0011:1
    0100:0 0101:1 0110:1 0111:1
    1000:0 1001:1 1010:1 1011:2
    1100:1 1101:1 1110:2 1111:2
    2000:0 // ... compiler-generated for full range
]